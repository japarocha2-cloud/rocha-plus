rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/favorites/{id} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && id.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['name', 'url', 'group', 'logo', 'addedAt'])
        && request.resource.data.keys().hasOnly(['name', 'url', 'group', 'logo', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 300
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 4096
        && request.resource.data.url.matches('^https?://.+')
        && request.resource.data.group is string && request.resource.data.group.size() <= 300
        && (request.resource.data.logo == null ||
          (request.resource.data.logo is string && request.resource.data.logo.size() <= 4096
            && request.resource.data.logo.matches('^https?://.+')))
        && request.resource.data.addedAt == request.time;
    }
  }
}
