rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server-only records. Merge these matches into existing project rules.
    match /rochaBillingUsers/{document} { allow read, write: if false; }
    match /rochaBillingCheckouts/{document} { allow read, write: if false; }
    match /rochaBillingPayments/{document} { allow read, write: if false; }
  }
}
