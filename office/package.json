{
  "name": "rocha-office",
  "version": "0.3.0",
  "private": true,
  "description": "Rocha+ Office LAB \u2014 instaladores experimentais, sem licen\u00e7a comercial",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis",
    "android:init": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "check": "node --check electron/main.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.rochaplus.office.lab",
    "productName": "Rocha+ Office LAB",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "releases"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  }
}
