rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Entitlements and payment reconciliation records are server-owned.
    // Firebase Admin SDK bypasses these client security rules.
    match /entitlements/{uid} {
      allow read, write: if false;
    }
    match /payment_events/{eventId} {
      allow read, write: if false;
    }
    match /payment_claims/{paymentId} {
      allow read, write: if false;
    }
  }
}
